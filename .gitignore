# ==========================================
# Claim Portal - .gitignore
# ==========================================

# ------------------------------------------
# Root & Monorepo Artifacts
# ------------------------------------------
/package-lock.json

# ------------------------------------------
# Java & Spring Boot (Maven)
# ------------------------------------------
target/
**/target/
*.class

# Compiled archives
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven wrapper / local cache (keep wrapper script & jar if committed)
!.mvn/wrapper/maven-wrapper.jar

# Spring Boot devtools reload trigger
.reloadtrigger

# Embedded & local databases (H2, SQLite)
*.mv.db
*.trace.db
*.h2.db
*.db
*.sqlite

# ------------------------------------------
# Node.js & Frontend (React / Vite)
# ------------------------------------------
node_modules/
**/node_modules/

# Vite & build output
dist/
**/dist/
dist-ssr/
*.local

# Vite / bundler caches
.vite/
**/.vite/
.cache/
.eslintcache
.stylelintcache
.tsbuildinfo

# Test & coverage output
coverage/
**/coverage/
*.lcov
.nyc_output/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Environment & Secrets (Never commit credentials)
# ------------------------------------------
.env
.env.local
.env.*.local
!.env.example

# ------------------------------------------
# IDEs & Text Editors
# ------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Eclipse
.metadata
bin/
tmp/
*.tmp
*.bak
*.swp
*~
local.properties
.settings/
.project
.classpath

# ------------------------------------------
# Operating System Files
# ------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
